{
  "name": "ai-investment-atmosphere",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "data:infrastructure": "node scripts/data-pipeline.mjs build --group infrastructure",
    "data:frontier-labs": "node scripts/data-pipeline.mjs build --group labs",
    "data:task-economics": "node scripts/data-pipeline.mjs build --group task",
    "data:useful-task": "node scripts/data-pipeline.mjs build --group task",
    "data:epoch-pricing": "node scripts/data-pipeline.mjs collect pricing",
    "data:swebench": "node scripts/data-pipeline.mjs collect swebench",
    "dev": "node ./node_modules/vinext/dist/cli.js dev --port 8000",
    "build": "node ./node_modules/vinext/dist/cli.js build",
    "start": "node scripts/start-network-server.mjs --port 8000",
    "test": "node ./node_modules/vinext/dist/cli.js build",
    "data:refresh": "node scripts/data-pipeline.mjs refresh --web-root .",
    "data:build": "node scripts/data-pipeline.mjs build --group all",
    "data:status": "node scripts/data-pipeline.mjs status",
    "data:sync": "node scripts/data-pipeline.mjs sync --web-root ."
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  }
}
